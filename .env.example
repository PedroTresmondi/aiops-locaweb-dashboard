# Variáveis de ambiente da aplicação visionOps AI (AIOps SLA Monitor).
# Nenhuma delas é segredo: a autenticação no Azure é passwordless (Managed Identity).
# Localmente, deixe tudo em branco — o app usa o snapshot Parquet e não envia telemetria.

# --- Fonte de dados ---
# "parquet" (padrão, offline/auditável) ou "mysql" (Azure Database for MySQL).
VISIONOPS_DATASOURCE=parquet

# Só quando VISIONOPS_DATASOURCE=mysql (valores reais já configurados no ACI):
MYSQL_HOST=mysql-aiops-visionopsai.mysql.database.azure.com
MYSQL_USER=id-aiops-visionopsai
MYSQL_DATABASE=aiopsdb
AZURE_CLIENT_ID=<client-id-da-managed-identity-id-aiops-visionopsai>

# --- Estado operacional (fila e ações da Sprint 4) ---
# Caminho do SQLite. No container é efêmero (reinicia a cada deploy) — aceitável
# para o estado operacional; o snapshot histórico é a fonte auditada.
VISIONOPS_DB=/app/operacional.db

# --- Telemetria (Application Insights → Log Analytics) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string-do-appi-aiops-visionopsai>

# Porta HTTP dentro do container
PORT=8000
